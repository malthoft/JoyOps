-- Membuat Database
CREATE DATABASE joyops_db;
USE joyops_db;

-- Tabel 1: users (F1, F2 - Autentikasi & Role)
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL, -- Akan menyimpan hash password
    name VARCHAR(100) NOT NULL,
    role ENUM('Admin', 'Karyawan') NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel 2: machines (F4, F5 - Manajemen & Status Mesin)
CREATE TABLE machines (
    id INT AUTO_INCREMENT PRIMARY KEY,
    machine_code VARCHAR(20) NOT NULL UNIQUE,
    machine_type VARCHAR(50) NOT NULL,
    status ENUM('Tersedia', 'Digunakan', 'Dalam perbaikan', 'Tidak aktif') DEFAULT 'Tersedia',
    notes TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- Tabel 3: shifts (F6, F7 - Manajemen Shift Karyawan)
CREATE TABLE shifts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL, -- Berelasi dengan tabel users
    work_day VARCHAR(20) NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

-- Tabel 4: services (F9, F10 - Katalog Layanan & Harga)
CREATE TABLE services (
    id INT AUTO_INCREMENT PRIMARY KEY,
    service_name VARCHAR(100) NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel 5: transactions (F11, F12 - Laporan Keuangan Internal)
CREATE TABLE transactions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    transaction_date DATE NOT NULL,
    transaction_type ENUM('Pemasukan', 'Pengeluaran') NOT NULL,
    amount DECIMAL(15, 2) NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel 6: job_vacancies (F8 - Informasi Rekrutmen)
CREATE TABLE job_vacancies (
    id INT AUTO_INCREMENT PRIMARY KEY,
    position VARCHAR(100) NOT NULL,
    description TEXT NOT NULL,
    requirements TEXT NOT NULL,
    contact_info VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel 7: digital_assets (F13, F14 - Manajemen Aset)
CREATE TABLE digital_assets (
    id INT AUTO_INCREMENT PRIMARY KEY,
    asset_type ENUM('Logo', 'Foto', 'Video') NOT NULL,
    file_path VARCHAR(255) NOT NULL,
    uploaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);